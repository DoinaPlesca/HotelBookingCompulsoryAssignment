									"pm.test(\"Status is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response is a booking object\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData).to.be.an(\"object\");\r",
									"    pm.expect(jsonData).to.have.property(\"id\");\r",
									"    pm.expect(jsonData).to.have.property(\"startDate\");\r",
									"    pm.expect(jsonData).to.have.property(\"endDate\");\r",
									"    pm.expect(jsonData).to.have.property(\"customerId\");\r",
									"    pm.expect(jsonData).to.have.property(\"roomId\");\r",
									"    pm.expect(jsonData).to.have.property(\"customer\");\r",
									"    pm.expect(jsonData).to.have.property(\"room\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response id matches requested id\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    const expectedId = parseInt(pm.collectionVariables.get(\"bookingId\"));\r",
									"    pm.expect(jsonData.id).to.eql(expectedId);\r",
									"});"
